		package Req {
			requirement 'The RC-Car must either drive autonomously or through manual operation.' {
				requirement 'The RC-Car must detect its environment through sensors.';
				requirement 'The RC-Car must move using its actuators.';
				requirement 'The RC-Car must drive autonomously.' {
					requirement 'The RC-Car must control its actuators in autonomous mode.';
					requirement 'The RC-Car must plan its optimal route.';
					requirement 'The RC-Car must perceive its environment.' {
						requirement 'The RC-Car must know its current position.';
						requirement 'The RC-Car must detect nearby objects.';
					}
				}
				requirement 'The RC-Car must be remotely controlled by a Human Machine Interface (HMI).' {
					requirement 'The HMI must enable switching between manual and autonomous control.';
					requirement 'The HMI must enable manual control using a remote controller.';
					requirement 'The HMI must enable manual control through a website.';
					requirement 'The HMI must alarm the user of low battery voltage.';
					requirement 'The HMI must show sensor data.';
				}
			}
		}
	}
}
