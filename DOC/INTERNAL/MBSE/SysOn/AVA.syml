	package Connection {
		flow from Part::'Zeee-4S-14.8V-100C-48.84Wh'.VCC.VCC to Part::'609W-HX'.VCC.VCC;
		flow from Part::'609W-HX'.VDD.VDD to Part::'Jetson Orin NX'.VDD.VDD;
		flow from Part::'Zeee-4S-14.8V-100C-48.84Wh'.VCC.VCC to Part::LM2696S.VCC.VCC;
		flow from Part::LM2696S.VDD.VDD to Part::'WS2812B-RGB-LED-B'.VCC.VCC;
		flow from Part::LM2696S.VDD.VDD to Part::'WS2812B-RGB-LED-F'.VCC.VCC;
		flow 'Acceleration-Data' from.to Part::'ESP32-DevKitC'.null.;
		flow from Part::'Zeee-2S-7.4V-100C-8Ah-LiPo'.VCC.VCC to Part::'RBR-C120A'.VCC.VCC;
		flow from Part::'Zeee-2S-7.4V-100C-8Ah-LiPo'.VCC.VCC to.;
		flow from Part::'RBR-C120A'.VDD.VDD to Part::SRTCH260S.VDD.VDD;
		flow 'Encoder-Data' from Part::SS411A.DOU.DOU to Part::'ESP32-C3-SuperMini'.GPIO5.GPIO5;
		flow 'Battery-Voltage' from Part::'Zeee-4S-14.8V-100C-48.84Wh'.VCC.VCC to Part::'ESP32-C3-SuperMini'.A0.A0;
		flow 'Battery-Voltage' from Part::'Zeee-2S-7.4V-100C-8Ah-LiPo'.VCC.VCC to Part::'ESP32-C3-SuperMini'.A1.A1;
		flow 'Acceleration-Data' from Part::BNO085.DOU.DOU to Part::'Jetson Orin NX'.'GPIO-A'.'GPIO-A';
		flow 'Image-Data' from Part::'Arducam-UC-852'.USB.USB to Part::'Jetson Orin NX'.'USB-0'.'USB-0';
		flow 'Distance-Data' from Part::'STL-27'.USB.USB to Part::'Jetson Orin NX'.'USB-1'.'USB-1';
		flow 'Drive-Mode' from Part::'ESP32-DevKitC'.GPIO4.GPIO4 to Part::'WS2812B-RGB-LED-F'.DIN.DIN;
		flow 'Drive-Mode' from Part::'ESP32-DevKitC'.GPIO18.GPIO18 to Part::'WS2812B-RGB-LED-B'.DIN.DIN;
		flow 'Acceleration-Signal' from Part::'ESP32-DevKitC'.GPIO21.GPIO21 to Part::'RBR-C120A'.DIN.DIN;
		flow 'Acceleration-Data' from Part::'MEUS-Racing-10B'.CH2.CH2 to Part::'ESP32-DevKitC'.GPIO22.GPIO22;
		flow 'Steering-Data' from Part::'MEUS-Racing-10B'.CH1.CH1 to Part::'ESP32-DevKitC'.GPIO23.GPIO23;
		connect Part::SMA.SMA to Part::'ESP32-DevKitC'.'Wifi-Comms';
		connect Part::'ESP32-DevKitC'.USB to Part::'Jetson Orin NX'.USB;
		connect Part::'Jetson Orin NX'.'Technology-Level'::Part::'Jetson Orin NX'::USB to Part::'ESP32-C3-SuperMini'.USB;
		connection Comms connect Part::'ESP32-DevKitC'.UART to Part::'ESP32-C3-SuperMini'.UART;
	}
	package Behaviour {
		view 'Autonomous-Drive' : StandardViewDefinitions::ActionFlowView {
			expose 'Drive autonomously';
			expose 'Drive autonomously'::'Harvest sensor data';
			expose 'Drive autonomously'::Fork1;
			expose 'Drive autonomously'::'Localize current position';
			expose 'Drive autonomously'::'Detect nearby objects';
			expose 'Drive autonomously'::'Calculate optimal path';
			expose 'Drive autonomously'::'Control actuators for optimal trajectory';
			expose 'Drive autonomously'::Node1;
			expose 'Drive autonomously'::'Autonomous mode enabled?';
			expose 'Drive autonomously'::'Check drive mode';
			expose 'Drive autonomously'::'Enter standby mode';
		}
		view 'Operational-Mode' : StandardViewDefinitions::ActionFlowView {
			expose 'Run in standby';
			expose 'Run in standby'::'Check secondary ECUs';
			expose 'Run in standby'::'Resume operation';
			expose 'Run in standby'::'Failed check?';
			expose 'Run in standby'::'Error signal to LEDs, webinterface';
			expose 'Run in standby'::'Check selected drive mode';
			expose 'Run in standby'::'Manual mode selected?';
			expose 'Run in standby'::'Standby selected';
			expose 'Run in standby'::'Back to start';
			expose 'Run in standby'::'Drive autonomously';
			expose 'Run in standby'::'Drive manually';
		}
		view 'Manual-Drive' : StandardViewDefinitions::ActionFlowView {
			expose 'Drive manually';
			expose 'Drive manually'::'Check drive mode';
			expose 'Drive manually'::'Manual mode enabled?';
			expose 'Drive manually'::'Harvest control data from radio receiver';
			expose 'Drive manually'::'Control actuators';
			expose 'Drive manually'::'Enter standby mode';
		}
		action 'Run in standby' {
			action 'Check secondary ECUs';
			action 'Resume operation';
			first start then 'Check secondary ECUs';
			decide 'Failed check?';
			first 'Check secondary ECUs' then 'Failed check?';
			succession No first 'Failed check?' then 'Resume operation';
			action 'Error signal to LEDs, webinterface';
			succession Yes first 'Failed check?' then 'Error signal to LEDs, webinterface';
			action 'Check selected drive mode';
			first 'Resume operation' then 'Check selected drive mode';
			decide 'Manual mode selected?';
			first 'Check selected drive mode' then 'Manual mode selected?';
			succession No first 'Manual mode selected?' then 'Drive autonomously';
			succession Yes first 'Manual mode selected?' then 'Drive manually';
			merge 'Standby selected';
			first 'Drive manually' then 'Standby selected';
			first 'Drive autonomously' then 'Standby selected';
			merge 'Back to start';
			first 'Error signal to LEDs, webinterface' then 'Back to start';
			first 'Standby selected' then 'Back to start';
			first 'Back to start' then done;
			perform 'Drive autonomously';
			perform 'Drive manually';
		}
		action 'Drive autonomously' {
			first start then;
			first then 'Harvest sensor data';
			first then 'Harvest sensor data';
			first then 'Harvest sensor data';
			action 'Harvest sensor data';
			fork Fork1;
			action 'Localize current position';
			action 'Detect nearby objects';
			first 'Harvest sensor data' then Fork1;
			first Fork1 then 'Localize current position';
			first Fork1 then 'Detect nearby objects';
			action 'Calculate optimal path';
			action 'Control actuators for optimal trajectory';
			join Node1;
			first 'Localize current position' then Node1;
			first 'Detect nearby objects' then Node1;
			first Node1 then 'Calculate optimal path';
			decide 'Autonomous mode enabled?';
			action 'Check drive mode';
			first start then 'Check drive mode';
			first 'Check drive mode' then 'Autonomous mode enabled?';
			succession Yes first 'Autonomous mode enabled?' then 'Harvest sensor data';
			action 'Enter standby mode';
			succession No first 'Autonomous mode enabled?' then 'Enter standby mode';
			first 'Enter standby mode' then done;
			first 'Calculate optimal path' then 'Control actuators for optimal trajectory';
			first 'Control actuators for optimal trajectory' then 'Check drive mode';
		}
		action 'Drive manually' {
			first start then;
			action 'Check drive mode';
			first start then 'Check drive mode';
			decide 'Manual mode enabled?';
			first 'Check drive mode' then 'Manual mode enabled?';
			action 'Harvest control data from radio receiver';
			succession Yes first 'Manual mode enabled?' then 'Harvest control data from radio receiver';
			action 'Control actuators';
			action 'Enter standby mode';
			first 'Enter standby mode' then done;
			succession No first 'Manual mode enabled?' then 'Enter standby mode';
			first 'Harvest control data from radio receiver' then 'Control actuators';
			first 'Control actuators' then 'Check drive mode';
		}
	}
	flow from Part::'Zeee-2S-7.4V-100C-8Ah-LiPo'.VCC.VCC to Part::'Carson-606257'.VCC.VCC;
	flow 'Steering-Signal' from Part::'ESP32-DevKitC'.GPIO19.GPIO19 to Part::'Carson-606257'.DIN.DIN;
}